{
  "name": "wnc-testhub",
  "version": "1.0.0",
  "private": true,
  "description": "WNC TestHub desktop application (Electron shell around the React frontend and FastAPI backend)",
  "main": "electron/main.cjs",
  "scripts": {
    "frontend:install": "cd frontend && npm install",
    "frontend:build": "cd frontend && npm run build",
    "backend:setup": "node scripts/prepare-backend-venv.js",
    "backend:build": "npm run backend:setup && node scripts/run-pyinstaller.js",
    "electron": "electron .",
    "electron:dev": "npm run backend:setup && npm run frontend:build && electron .",
    "playwright:bundle": "node scripts/prepare-playwright-browsers.js",
    "dist": "npm run backend:build && npm run frontend:build && npm run playwright:bundle && electron-builder"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.wnc.testhub",
    "productName": "WNC TestHub",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "frontend/dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend/dist/WNCTestHubBackend",
        "to": "backend",
        "filter": ["**/*"]
      },
      {
        "from": "backend/playwright-browsers",
        "to": "playwright-browsers",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
